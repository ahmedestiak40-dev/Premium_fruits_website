PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/premium-fruits
JWT_SECRET=replace-with-a-long-random-secret

# Get sandbox credentials from https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=your-sandbox-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sandbox-store-password
SSLCOMMERZ_IS_LIVE=false

# Must be publicly reachable over HTTPS so SSLCommerz can send callbacks/IPN.
BACKEND_PUBLIC_URL=https://your-public-backend.example.com
FRONTEND_URL=http://localhost:3001

# Groq customer support assistant. Keep this key on the backend only.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_ASSISTANT_BUSINESS_NAME=Premium Fruits
AI_ASSISTANT_TONE=Warm, concise, practical, and honest. Match the customer's language.
# Optional: replace the default store-support rules with your own instructions.
AI_ASSISTANT_INSTRUCTIONS=